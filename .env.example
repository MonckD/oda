# Copiez ce fichier en `.env` à la racine du projet puis remplissez les valeurs.

# ===== Backend : base de données =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oda_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# ===== Backend : serveur API =====
PORT=3000

# ===== Frontend : serveur Vite =====
FRONTEND_PORT=5173

# ===== Frontend : adresse de l'API (proxy) =====
API_PROXY=http://localhost:3000